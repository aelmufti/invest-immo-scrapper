# Copier ce fichier vers .env et adapter les valeurs.
# Le fichier .env n'est JAMAIS commité (cf .gitignore).

# --- Base ---
DATABASE_URL=sqlite:///./data.db

# --- API ---
API_HOST=127.0.0.1
API_PORT=8765

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO

# --- Scheduler (fréquences en minutes) ---
SCHED_DVF_REFRESH_MIN=10080      # 1 fois par semaine
SCHED_CONNECTORS_MIN=360         # toutes les 6h
SCHED_RESCORE_MIN=60             # 1 fois par heure

# --- Notifications ---
NOTIFY_DESKTOP_ENABLED=true
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Connecteurs (Couche B). DESACTIVES par défaut.
# Le scraping peut violer les CGU des sites tiers. Sous votre responsabilité.
CONNECTOR_EXAMPLE_ENABLED=false
